# This file specifies files that are NOT uploaded to Google Cloud Build
# Speeds up deployments by excluding large/irrelevant directories

# Flutter build output
build/

# Flutter/Dart cache
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Android/iOS build artifacts
android/.gradle/
android/app/build/
ios/Pods/
ios/.symlinks/

# Gradle home cache (contains very long paths that break Windows archival)
.gradle-home/
.gradle/

# Node modules (outside web_dashboard)
node_modules/

# IDE files
.idea/
*.iml
.vscode/

# Git
.git/
.gitignore

# Local environment files
.env
.env.local
.env.*.local

# Logs
*.log
*.txt

# macOS
.DS_Store

# Windows
Thumbs.db

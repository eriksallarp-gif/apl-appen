rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Assessment images - students can upload, everyone authenticated can read
    match /assessment_images/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // APL Documents - teachers upload, all authenticated users can read
    match /apl-documents/{category}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isSignedIn();
    }

    // Assignment media uploads
    // Path format: assignments/{assignmentId}/{studentId}/{fileName}
    match /assignments/{assignmentId}/{studentId}/{fileName} {
      allow read: if isSignedIn();

      // Only the authenticated owner of the student folder may upload/update/delete.
      allow write: if isOwner(studentId)
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|video/.*');
    }
  }
}

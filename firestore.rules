    rules_version = '2';
    service cloud.firestore {
      match /databases/{database}/documents {

        // Helper functions (safe role lookup)
        function isSignedIn() {
          return request.auth != null;
        }

        function userDocExists() {
          return exists(/databases/$(database)/documents/users/$(request.auth.uid));
        }

        function getUserRole() {
          return userDocExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
        }

        function isAdmin() {
          return isSignedIn() && getUserRole() == 'admin';
        }

        function isTeacher() {
          return isSignedIn() && getUserRole() == 'teacher';
        }

        function isStudent() {
          return isSignedIn() && getUserRole() == 'student';
        }

        function isTeacherOrAdmin() {
          return isTeacher() || isAdmin();
        }

        function getUserStatus() {
          return userDocExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') : 'active';
        }

        function isUserActive() {
          return isSignedIn() && getUserStatus() != 'frozen';
        }

        function hasCurrentGdprConsent() {
          return userDocExists() &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('gdprConsentVersion', '') == '2026-03-25';
        }

        function userSchool() {
          return userDocExists()
            ? (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('school', ''))
            : '';
        }

        function assignmentExists(assignmentId) {
          return exists(/databases/$(database)/documents/assignments/$(assignmentId));
        }

        function isAssignmentOwner(assignmentId) {
          return assignmentExists(assignmentId)
            && get(/databases/$(database)/documents/assignments/$(assignmentId)).data.createdBy == request.auth.uid;
        }

        function isAssignedToAssignment(assignmentId) {
          return assignmentExists(assignmentId)
            && get(/databases/$(database)/documents/assignments/$(assignmentId)).data.assignedTo.hasAny([request.auth.uid]);
        }

        // Schools collection - tillåt alla att läsa skolor (för registrering)
        match /schools/{schoolId} {
          allow read: if true;
          // Skrivregler kan vara mer restriktiva
        }

        // Users collection
        match /users/{userId} {
          // Anyone authenticated can read any user (for name lookups, etc.)
          allow read: if isSignedIn();

          // Users can create their own profile during registration
          // Users can write their own profile (only if active)
          // Teachers and admins can write any user (including status field)
          allow create: if request.auth.uid == userId;
          allow update: if isSignedIn() && (
            (request.auth.uid == userId && isUserActive()) || 
            isAdmin()
          );
          allow delete: if isAdmin();
        }

        // Admin Notifications collection
        match /adminNotifications/{notificationId} {
          // Only admins can read notifications
          allow read: if isAdmin();

          // Anyone can create notifications (för nya lärarregistreringar)
          allow create: if true;

          // Only admins can update/delete notifications
          allow update, delete: if isAdmin();
        }

        // Classes collection
        match /classes/{classId} {
          // Teachers and admins can read/write classes
          allow read: if isSignedIn();
          allow write: if isTeacherOrAdmin();

          // Students subcollection
          match /students/{studentId} {
            allow read: if isSignedIn();
            allow write: if isTeacherOrAdmin() || (isStudent() && request.auth.uid == studentId);
          }

          // Student week overrides
          match /studentWeekOverrides/{studentId} {
            allow read: if isSignedIn();
            allow write: if isTeacherOrAdmin();
          }
        }

        // ClassCodes collection (för klasskoder kopplade till klasser)
        match /classCodes/{codeId} {
          allow read: if isTeacherOrAdmin();
          allow create: if isTeacherOrAdmin();
          allow update, delete: if isTeacherOrAdmin();
        }

        // Timesheets collection
        match /timesheets/{timesheetId} {
          function isOwnTimesheetPath() {
            return isSignedIn() && isStudent() &&
              timesheetId.matches('^' + request.auth.uid + '_.*$');
          }

          // Students can only read their own timesheets.
          // Teachers can read timesheets belonging to their students.
          // Admins can read all.
          allow read: if isSignedIn() && (
            isOwnTimesheetPath() ||
            request.auth.uid == resource.data.studentUid ||
            request.auth.uid == resource.data.teacherUid ||
            isAdmin()
          );

          // Students can create their own timesheets (if active).
          // They cannot pre-set approved or locked to true on creation.
          allow create: if isUserActive() && hasCurrentGdprConsent() &&
            request.auth.uid == request.resource.data.studentUid &&
            request.resource.data.get('approved', false) == false &&
            request.resource.data.get('locked', false) == false;

          // Students can update their own non-locked timesheets,
          // but are NOT allowed to change the approved or locked fields.
          // Teachers can update any of their students' timesheets (incl. approval).
          // Admins can update any timesheet.
          allow update: if isUserActive() && (
            (
              request.auth.uid == resource.data.get('studentUid', '') &&
              hasCurrentGdprConsent() &&
              resource.data.get('locked', false) != true &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved', 'locked'])
            ) ||
            request.auth.uid == resource.data.get('teacherUid', '') ||
            isAdmin()
          );

          // Only teachers and admins can delete
          allow delete: if isTeacherOrAdmin();
        }

        // Assessments collection
        match /assessments/{assessmentId} {
          // Anyone authenticated can read assessments
          allow read: if isSignedIn();

          // Only teachers and admins can create/update/delete assessments
          allow write: if isTeacherOrAdmin();
        }

        // Messages collection
        match /messages/{messageId} {
          // Users can read messages sent to them or sent by them
          allow read: if isSignedIn() && (
            request.auth.uid == resource.data.to ||
            request.auth.uid == resource.data.from ||
            isAdmin()
          );

          // Teachers can create messages
          // Students can create messages to their teacher
          allow create: if isSignedIn() && (
            isTeacherOrAdmin() ||
            request.auth.uid == request.resource.data.from
          );

          // Only sender or admin can update/delete
          allow update, delete: if isSignedIn() && (
            request.auth.uid == resource.data.from ||
            isAdmin()
          );
        }

        // Compensation collection
        match /compensation/{compensationId} {
          // Anyone authenticated can read
          allow read: if isSignedIn();

          // Students can create their own compensation claims (if active)
          allow create: if isUserActive() && hasCurrentGdprConsent() && 
            request.auth.uid == request.resource.data.studentUid;

          // Students can update their own (unless approved) - must be active
          // Teachers can update any (for approval)
          allow update: if isUserActive() && (
            (request.auth.uid == resource.data.studentUid && 
             hasCurrentGdprConsent() &&
             resource.data.approved != true) ||
            isTeacherOrAdmin()
          );

          // Only teachers and admins can delete
          allow delete: if isTeacherOrAdmin();
        }

        // Invites collection (for student-teacher connection)
        match /invites/{inviteCode} {
          // Anyone can read invites (to validate codes)
          allow read: if isSignedIn();

          // Only teachers can create invites
          allow create: if isTeacher() || isAdmin();

          // Teachers can update/delete their own invites
          allow update, delete: if isSignedIn() && (
            request.auth.uid == resource.data.teacherUid ||
            isAdmin()
          );
        }

        // Assessment Requests collection (för bedömningsförfrågningar med QR-kod)
        match /assessmentRequests/{requestId} {
          // Endast inloggade användare med rätt roll får läsa direkt.
          // Handledarflöde går via Cloud Function som validerar token server-side.
          allow read: if isTeacherOrAdmin() ||
            (isSignedIn() && request.auth.uid == resource.data.studentUid);

          // Elev kan skapa sin egen request med ett begränsat schema.
          allow create: if isUserActive() && hasCurrentGdprConsent() &&
            request.auth.uid == request.resource.data.studentUid &&
            request.resource.data.get('status', 'pending') == 'pending' &&
            request.resource.data.keys().hasOnly([
              'studentUid', 'studentName',
              'timesheetIds', 'weeks',
              'totalHours', 'lunchCount', 'travelCount',
              'status', 'createdAt', 'token', 'expiresAt',
              'images',
              'linkedCompanyName', 'studentCompanyName',
              'studentSelfAssessment',
              'assessmentTemplateSnapshot'
            ]);

          // Endast lärare/admin får uppdatera direkt i klient.
          // Handledarens inskick sker via Cloud Function.
          allow update: if isTeacherOrAdmin();

          // Only teachers and admins can delete
          allow delete: if isTeacherOrAdmin();
        }

        // Companies collection (för APL-företag)
        match /companies/{companyId} {
          // Teachers/admins can read all, students can read only their linked company
          allow read: if isTeacherOrAdmin() || (isStudent() && resource.data.studentId == request.auth.uid);

          // Teachers can create companies
          allow create: if isTeacher() || isAdmin();

          // Teachers can update/delete their own companies, admins can update/delete any
          allow update, delete: if isSignedIn() && (
            request.auth.uid == resource.data.teacherUid ||
            isAdmin()
          );
        }

        // APL Documents collection (viktiga dokument för elever)
        match /aplDocuments/{documentId} {
          // Authenticated users can only read documents from their own school (and must be active)
          allow read: if isUserActive()
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.school
               == resource.data.school;

          // Teachers and admins can create documents (must be active)
          allow create: if isUserActive()
            && isTeacherOrAdmin()
            && request.resource.data.school
               == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.school
            && request.resource.data.teacherId == request.auth.uid;

          // Teachers and admins can update/delete documents (must be active)
          allow update, delete: if isUserActive() && isTeacherOrAdmin();
        }

        // App settings and shared catalogs
        match /appSettings/{documentId} {
          allow read: if isSignedIn();
          allow create, update, delete: if isAdmin();
        }

        // Teacher-specific timesheet templates
        match /timesheetTemplates/{templateId} {
          allow read: if isSignedIn() && (
            isAdmin() ||
            (isTeacher() && templateId.matches('^' + request.auth.uid + '__.*$')) ||
            (
              isStudent() &&
              templateId.matches(
                '^' +
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teacherUid +
                '__.*$'
              )
            )
          );

          allow create: if isSignedIn() && (
            isAdmin() ||
            (isTeacher() && request.resource.data.teacherUid == request.auth.uid)
          );

          allow update, delete: if isSignedIn() && (
            isAdmin() ||
            (isTeacher() && resource.data.teacherUid == request.auth.uid)
          );
        }

        // Admin-managed default timesheet templates per program/specialization
        match /defaultTimesheetTemplates/{templateId} {
          allow read: if isSignedIn();
          allow create, update, delete: if isAdmin();
        }

        // Assignments collection (uppgifter)
        match /assignments/{assignmentId} {
          // Teachers who created the assignment can read/write it.
          // Assigned students can read only their own assigned assignments.
          // Use resource.data directly (not get()) so collection queries (list) work correctly.
          allow read: if isUserActive() && (
            resource.data.createdBy == request.auth.uid ||
            isAdmin() ||
            (isStudent() && resource.data.assignedTo.hasAny([request.auth.uid]))
          );

          allow create: if isUserActive() && isTeacher()
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.schoolId == userSchool();

          allow update, delete: if isUserActive() && (
            (isTeacher() && isAssignmentOwner(assignmentId)) ||
            isAdmin()
          );

          // Student submissions for one assignment
          match /submissions/{studentId} {
            allow read: if isUserActive() && (
              (isTeacher() && isAssignmentOwner(assignmentId)) ||
              isAdmin() ||
              (isStudent() && request.auth.uid == studentId && isAssignedToAssignment(assignmentId))
            );

            // Enforce one submission per student per assignment by document id = student uid.
            allow create: if isUserActive()
              && isStudent()
              && request.auth.uid == studentId
              && isAssignedToAssignment(assignmentId)
              && !exists(/databases/$(database)/documents/assignments/$(assignmentId)/submissions/$(studentId));

            // Student cannot overwrite after submit. Teacher/admin can review/update.
            allow update, delete: if isUserActive() && (
              (isTeacher() && isAssignmentOwner(assignmentId)) ||
              isAdmin()
            );
          }

          // Optional assignee state docs for badge/new tracking
          match /assignees/{studentId} {
            allow read: if isUserActive() && (
              (isTeacher() && isAssignmentOwner(assignmentId)) ||
              isAdmin() ||
              (isStudent() && request.auth.uid == studentId && isAssignedToAssignment(assignmentId))
            );

            allow create, update: if isUserActive() && (
              (isTeacher() && isAssignmentOwner(assignmentId)) ||
              isAdmin() ||
              (isStudent() && request.auth.uid == studentId && isAssignedToAssignment(assignmentId))
            );

            allow delete: if isUserActive() && (
              (isTeacher() && isAssignmentOwner(assignmentId)) ||
              isAdmin()
            );
          }
        }

        // Default deny everything else
        match /{document=**} {
          allow read, write: if false;
        }
      }
    }
